# Contraseña del panel de administración
ADMIN_PASSWORD=cambia-esto

# Secreto para firmar la cookie de sesión (cualquier cadena larga y aleatoria)
SESSION_SECRET=cambia-esto-tambien-largo-y-aleatorio

# URL pública de la app (usada al generar el QR). En desarrollo puede omitirse.
APP_BASE_URL=http://localhost:3000

# --- Integración con Google Sheets (producción) ---
# Si se dejan vacías, la app usa un almacenamiento local en data/projects.json
# Ver README.md para desplegar el Apps Script y obtener estos valores.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=
